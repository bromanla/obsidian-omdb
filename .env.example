# API credentials and permitted Telegram user IDs
OMDB_TOKEN=xxx
TMDB_TOKEN=xxx
TELEGRAM_TOKEN=xxx
TELEGRAM_USERS=123456789

# Optional. The bot defaults to en-US.
# TMDB_LANGUAGE=ru-RU

# Uncomment for make dev to write to the local data directory.
# OUTPUT_DIR=./data

# Host directory mounted by Docker Compose.
HOST_OUTPUT_DIR=./data
